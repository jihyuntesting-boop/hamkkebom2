# .env.local 로 복사한 뒤 값을 채우세요. .env.local 은 절대 커밋하지 마세요.
# cp .env.example .env.local

# 공공데이터포털 서비스 키 (관광정보·무장애·기상청 예보/특보·대표 관광지)
DATA_GO_KR_KEY=

# 네이버 지도 Web Dynamic Map Client ID (허용 도메인에 http://localhost:3000 등록 필요)
# 개발 서버가 화면 JS의 YOUR_NAVER_MAP_CLIENT_ID 자리에 서빙 시점에 넣어 줍니다.
HB_NAVER_MAP_CLIENT_ID=

# 네이버 길찾기 (자동차 이동시간). 사용하려면 1 로 설정
HB_NAVER_DIRECTIONS_ENABLED=
HB_NAVER_DIRECTIONS_ID=
HB_NAVER_DIRECTIONS_SECRET=

# 추천/이동시간 API가 장소 목록을 읽어오는 서버 주소.
# 비워 두면 로컬 개발 서버 자신(http://localhost:<port>)을 사용합니다.
HB_LEGACY_API_BASE=
