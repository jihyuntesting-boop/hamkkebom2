# Editor defaults for new edits. This does not reformat anything by itself.
# Existing compact files also use 1-space indents; keep the local style of the
# lines you touch instead of re-indenting whole files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{js,cjs,mjs,json,yml,yaml,css,html}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
